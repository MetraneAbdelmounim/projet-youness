# Build context is the repository root, so this file governs both images.
.git
.gitignore
**/node_modules
**/venv
**/__pycache__
**/.angular
**/*.pem
# …but the licence PUBLIC key must ship: without it the server cannot verify a
# licence, so none can ever be installed and the API stays locked forever.
# It is public by definition — it only verifies, it cannot sign.
!backend/config/licence-public-key.pem
**/*.mi8lic
**/.env
**/.env.*
!**/.env.example

# The frontend bundle is produced inside the image by the build stage; never
# copy a locally-built one in, or the image silently ships a stale UI.
backend/public

backend/uploads
backend/api.log
front-end/dist
README.md
DEPLOYMENT.md
