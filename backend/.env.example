# Copy to .env and fill in. Never commit .env.
#
# ROTATION REQUIRED — the following values were previously hard-coded in
# backend/config/config.js and are still readable in git history. Generate new
# ones; the old ones must be considered compromised:
#   - JWT_SECRET   (was a public jwt.io example token — allowed token forgery)
#   - SMTP_PASS    (was 'Axians@2024')
#   - the admin bcrypt hash formerly in backend/auth/auth.js
#
# Generate a strong JWT secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

NODE_ENV=development
HOST=127.0.0.1
PORT=5000

MONGO_URL=mongodb://127.0.0.1:27017/mppt

JWT_SECRET=
# ~24.6 days. Keep below 596h: the client's auto-logout uses setTimeout, which
# saturates at 2^31-1 ms (~24.86 days).
JWT_EXPIRATION=590h

# Python polling service
HOST_PY=127.0.0.1
PORT_PY=8000

LICENCE_EXPIRY=2026-09-01

# Comma-separated. Leave empty when the API and UI share an origin.
CORS_ORIGINS=http://localhost:4200

# Mail
MAIL_FROM=notifications@innovationmi8.com
MAIL_TO=
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MEMBER_EMAIL_DOMAIN=innovationmi8.com

# Your company/product name — the party that ISSUES licences, i.e. you.
# Not the customer running the install. Shown on the licence screen as the
# contact for renewals. Leave empty and the UI says "votre fournisseur".
VENDOR_NAME=

# Scheduling
ALERT_SCHEDULE=*/15 * * * *
NIGHTLY_SCHEDULE=0 0 * * *
TZ=America/Montreal
REMINDER_INTERVAL_MS=43200000
RELOAD_MIDNIGHT_DEFAULT=false

MAX_UPLOAD_BYTES=5242880
